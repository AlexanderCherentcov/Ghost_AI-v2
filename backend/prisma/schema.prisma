generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum Plan {
  FREE
  START
  BASIC
  PRO
  PRO_PLUS
  VIP
  ULTRA
}

enum Billing {
  MONTHLY
  YEARLY
}

enum PromoRewardType {
  CASPERS
  DISCOUNT_PERCENT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CANCELED
  REFUNDED
}

enum TicketStatus {
  OPEN
  ASSIGNED
  CLOSED
}

enum MessageDirection {
  IN  // от пользователя оператору
  OUT // от оператора пользователю
}

enum GalleryStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── MODELS ───────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  birthDate     DateTime?
  email         String?   @unique
  telegramId    String?   @unique
  yandexId      String?   @unique
  googleId      String?   @unique
  avatarUrl     String?

  plan          Plan      @default(FREE)
  planExpiresAt DateTime?
  billing       Billing   @default(MONTHLY)

  // ── Caspers balance ───────────────────────────────────────────────────────
  caspers_balance  Int      @default(0)   // current spendable balance
  caspers_monthly  Int      @default(0)   // amount granted per billing period

  // ── Daily counters (reset at day_start + 1 day) ───────────────────────────
  std_messages_today  Int      @default(0)
  pro_messages_today  Int      @default(0)

  // ── FREE tier weekly counters (reset at week_start + 7 days) ─────────────
  images_this_week   Int      @default(0)
  music_this_week    Int      @default(0)
  // ── FREE tier monthly counter (reset at month_start + 30 days) ───────────
  videos_this_month  Int      @default(0)

  // ── Timestamps for period resets ─────────────────────────────────────────
  day_start    DateTime  @default(now())
  week_start   DateTime  @default(now())
  month_start  DateTime  @default(now())
  period_start DateTime  @default(now())

  // ── Onboarding ────────────────────────────────────────────────────────────
  purposes      String[]  @default([])
  responseStyle String    @default("ghost")
  onboardingDone Boolean  @default(false)

  // Согласие с пользовательским соглашением и политикой конфиденциальности.
  // Для OAuth/Telegram-виджет регистраций проставляется при создании учётки
  // (чекбокс на /register уже гейтит сами кнопки входа). Для бота — только
  // явным тапом "✅ Принимаю" (см. bot.ts), т.к. /auth/telegram-bot дёргается
  // при каждом первом сообщении, а не только при регистрации через сайт.
  termsAcceptedAt DateTime?

  // ── Relations ─────────────────────────────────────────────────────────────
  messages          Message[]
  chats             Chat[]
  payments          Payment[]
  imageRequests     UserImageRequest[]
  casperTransactions CasperTransaction[]
  promoRedemptions   PromoRedemption[]
  supportTickets     SupportTicket[]
  galleryItems       GalleryItem[]
  galleryLikes       GalleryLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([telegramId])
}

model Chat {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @default("Новый чат")
  mode      String    @default("chat")
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, updatedAt])
}

model Message {
  id         String   @id @default(cuid())
  chatId     String
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  role       String   // 'user' | 'assistant'
  content    String   @db.Text
  mode       String   // 'chat' | 'vision' | 'sound' | 'reel' | 'think'
  complexity String?
  provider   String?
  cacheHit   Boolean  @default(false)
  tokensCost Int      @default(0)
  mediaUrl   String?
  fileName   String?
  createdAt  DateTime @default(now())

  @@index([chatId, createdAt])
  @@index([userId, createdAt])
}

model Payment {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  yokassaId     String        @unique
  amount        Float
  status        PaymentStatus @default(PENDING)
  plan          Plan?
  paymentType   String        @default("subscription") // "subscription" | "caspers"
  casperAmount  Int?          // for casper top-up purchases
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId, createdAt])
}

model CasperTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int      // positive = credit, negative = debit
  reason    String   // 'plan_grant' | 'topup' | 'chat_pro' | 'image' | 'video_std_4s' etc.
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ─── Promo codes ────────────────────────────────────────────────────────────

model PromoCode {
  id              String            @id @default(cuid())
  code            String            @unique // normalized uppercase
  rewardType      PromoRewardType
  casperAmount    Int?              // for CASPERS
  discountPercent Int?              // for DISCOUNT_PERCENT, 1-100
  applicablePlans Plan[]            @default([]) // empty = applies to all paid plans
  maxUses         Int?              // null = unlimited
  usesCount       Int               @default(0)
  active          Boolean           @default(true)
  expiresAt       DateTime?
  createdBy       String?           // admin Telegram ID, for audit
  createdAt       DateTime          @default(now())
  redemptions     PromoRedemption[]

  @@index([code])
}

model PromoRedemption {
  id              String          @id @default(cuid())
  promoCodeId     String
  promoCode       PromoCode       @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeSnapshot    String          // denormalized — survives even if PromoCode is later deleted
  rewardType      PromoRewardType
  casperAmount    Int?
  discountPercent Int?
  paymentId       String?         // set for DISCOUNT_PERCENT redemptions tied to a subscription payment

  createdAt DateTime @default(now())

  @@unique([promoCodeId, userId]) // one redemption per user per code — anti-reuse
  @@index([userId])
  @@index([paymentId])
}

model GenerateJob {
  id        String   @id @default(cuid())
  userId    String
  mode      String   // 'vision' | 'sound' | 'reel'
  status    String   @default("pending") // pending | processing | done | failed
  prompt    String   @db.Text
  mediaUrl  String?
  // id модели из реестра (config/models.ts), которой реально сделана работа —
  // проставляется воркером при завершении (vision/reel). Нужно для галереи
  // (services/gallery.ts:shareToGallery по jobId) — единственное место, откуда
  // можно узнать модель без похода в Message (у sound/voice не проставляется,
  // им шаринг в галерею не нужен).
  modelId   String?
  error     String?
  bullJobId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

model UserImageRequest {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  promptHash String
  createdAt  DateTime @default(now())

  @@unique([userId, promptHash])
  @@index([promptHash])
}

// ─── Тикеты поддержки ───────────────────────────────────────────────────────
// Один тикет = одна тема (topic) в Telegram-супергруппе поддержки.
// userId/telegramId нет для гостя с сайта без входа — тогда ответ оператора
// релеить некуда, тикет виден только текстом в теме.

model SupportTicket {
  id           String        @id @default(cuid())
  userId       String?
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegramId   String?       // куда релеить ответ оператора; null — только сайт, без бота
  guestEmail   String?
  status       TicketStatus  @default(OPEN)
  topicId      Int?          // message_thread_id темы в группе поддержки
  assigneeId   String?       // Telegram ID оператора, взявшего тикет
  assigneeName String?
  messages     SupportMessage[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([telegramId])
  @@index([topicId])
  @@index([status])
}

model SupportMessage {
  id        String            @id @default(cuid())
  ticketId  String
  ticket    SupportTicket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  direction MessageDirection
  text      String            @db.Text
  createdAt DateTime          @default(now())

  @@index([ticketId, createdAt])
}

// ─── Галерея работ пользователей ───────────────────────────────────────────
// Отдельная от Chat/Message/GenerateJob модель — специально НЕЗАВИСИМАЯ от их
// TTL-очистки (services/cleanup.ts удаляет старые сообщения и файлы видео по
// возрасту). Публикация в галерее копирует медиафайл в свою постоянную папку
// (uploads/gallery/) при одобрении — иначе опубликованная работа исчезла бы
// через MESSAGE_TTL_DAYS/VIDEO_TTL_DAYS молча, 404 на проде.

model GalleryItem {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain        String        // 'image' | 'video'
  modelId       String        // id модели из реестра (config/models.ts) — подпись "сделано на Kling"
  prompt        String        @db.Text
  mediaUrl      String        // копия файла в uploads/gallery/, НЕ исходный chat/generateJob mediaUrl
  status        GalleryStatus @default(PENDING)
  likes         GalleryLike[]
  likesCount    Int           @default(0) // денормализовано — сортировка топа без агрегации на каждый запрос
  createdAt     DateTime      @default(now())
  reviewedAt    DateTime?

  @@index([status, likesCount])
  @@index([userId, createdAt])
}

model GalleryLike {
  id            String      @id @default(cuid())
  galleryItemId String
  galleryItem   GalleryItem @relation(fields: [galleryItemId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([galleryItemId, userId]) // 1 лайк на пользователя — защита от накрутки
  @@index([userId])
}
